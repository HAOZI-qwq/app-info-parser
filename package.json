{
  "name": "app-info-parser-next",
  "version": "1.1.7-fixed.1",
  "description": "Maintained fork of app-info-parser with modern APK/IPA parsing fixes.",
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "typings": "./lib/index.d.ts",
  "files": [
    "bin/",
    "dist/",
    "lib/",
    "CHANGELOG.md",
    "FIXES.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node ./test/fixes.test.js",
    "build:browser": "rimraf dist/* && browserify lib/index.js -t [ babelify ] -s AppInfoParser | derequire > dist/app-info-parser.js",
    "minify": "uglifyjs ./dist/app-info-parser.js -o ./dist/app-info-parser.min.js -c -m",
    "dist": "npm run build:browser && npm run minify"
  },
  "bin": "./bin/index.js",
  "keywords": [
    "ipa",
    "apk",
    "parser",
    "browser",
    "node",
    "android",
    "resources.arsc"
  ],
  "author": "Quincy Chen <mail@chenquincy.cn>",
  "maintainers": [
    "HAOZI-qwq"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HAOZI-qwq/app-info-parser-next.git"
  },
  "bugs": {
    "url": "https://github.com/HAOZI-qwq/app-info-parser-next/issues"
  },
  "homepage": "https://github.com/HAOZI-qwq/app-info-parser-next#readme",
  "license": "MIT",
  "dependencies": {
    "bplist-parser": "^0.2.0",
    "bytebuffer": "^5.0.1",
    "commander": "^7.2.0",
    "cgbi-to-png": "^1.0.7",
    "isomorphic-unzip": "^1.1.5",
    "plist": "^3.0.1"
  },
  "devDependencies": {
    "@babel/core": "^7.4.4",
    "@babel/preset-env": "^7.4.4",
    "babelify": "^10.0.0",
    "browserify": "^16.2.3",
    "derequire": "^2.0.6",
    "rimraf": "^2.6.2",
    "uglify-es": "^3.3.9"
  }
}
